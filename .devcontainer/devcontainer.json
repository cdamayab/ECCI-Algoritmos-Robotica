{
    "name": "Python Console",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",

    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ]
        }
    },

     "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgl1 && pip install --no-cache-dir matplotlib numpy pandas ipykernel opencv-python",

    "remoteUser": "vscode"
}